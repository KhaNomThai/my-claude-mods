#!/usr/bin/env python3
# Bumps the patch version of every plugin this commit touches, in its plugin.json and in
# marketplace.json. A version already changed by hand is kept, with the numbers after the
# changed one set to 0 (1.1.3 -> 1.2.0). Enable once per clone: git config core.hooksPath .githooks
import json, os, re, subprocess, sys

def git(*a):
    return subprocess.run(['git', *a], capture_output=True, text=True, check=True).stdout

staged = git('diff', '--cached', '--name-only').split()
plugins = sorted({m.group(1) for f in staged if (m := re.match(r'plugins/([^/]+)/', f))})
if not plugins:
    sys.exit(0)

MARKET = '.claude-plugin/marketplace.json'

def set_version(path, name, old, new):
    # Text replace, not json.dump, so the file keeps its own formatting.
    text = open(path).read()
    if path == MARKET:
        # shortcut: assumes no nested {} before "version" in the plugin's entry; use a JSON edit if one appears.
        text = re.sub(r'("name":\s*"%s"[^}]*?"version":\s*")[^"]*"' % re.escape(name), r'\g<1>%s"' % new, text, count=1)
    else:
        text = re.sub(r'("version":\s*")%s"' % re.escape(old), r'\g<1>%s"' % new, text, count=1)
    open(path, 'w').write(text)
    git('add', path)

for name in plugins:
    pj = f'plugins/{name}/.claude-plugin/plugin.json'
    try:
        head = json.loads(git('show', f'HEAD:{pj}'))['version']
    except subprocess.CalledProcessError:
        continue  # a new plugin: its first version is whatever it was written with
    if not os.path.exists(pj):
        continue  # the plugin is being removed
    cur = json.load(open(pj))['version']
    if cur == head:
        major, minor, patch = map(int, cur.split('.'))
        new = f'{major}.{minor}.{patch + 1}'
        set_version(pj, name, cur, new)
        print(f'pre-commit: {name} {cur} -> {new}')
    else:
        # Bumped by hand: a new major or minor starts the numbers after it from 0.
        (hM, hm, _), (M, m, _) = (map(int, v.split('.')) for v in (head, cur))
        new = f'{M}.0.0' if M != hM else f'{M}.{m}.0' if m != hm else cur
        if new != cur:
            set_version(pj, name, cur, new)
            print(f'pre-commit: {name} {cur} -> {new}')
    set_version(MARKET, name, None, new)
